# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.db binary

package-lock.json linguist-generated=true
apps/*/src/contracts/** linguist-generated=true
